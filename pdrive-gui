detect_lang() {
  local l="${PDRIVE_LANG:-}"
  [[ -z "$l" && -f "$CONF_DIR/lang" ]] && l=$(<"$CONF_DIR/lang")
  [[ -z "$l" ]] && l="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
  l="${l%%[_.@-]*}"; l="${l,,}"
  case "$l" in en|ar|fr|es|de) echo "$l" ;; *) echo en ;; esac
}
load_lang() { lang_en; [[ "$LANG_CODE" != en ]] && "lang_$LANG_CODE"; }
LANG_CODE="$(detect_lang)"; load_lang
TITLE="Proton Drive"

# t KEY [args...]  -> translated text (printf template)
t() { local f="${T[$1]:-$1}"; shift; printf "$f" "$@"; }

# =====================================================================
#  UI helpers
# =====================================================================
HAS_GUI=0
if command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then HAS_GUI=1; fi

zt() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }   # escape for zenity markup

say() { if (( HAS_GUI )); then zenity --info  --no-wrap --title="$TITLE" --text="$(zt "$1")" 2>/dev/null; else printf '%s\n' "$1"; fi; }
err() { if (( HAS_GUI )); then zenity --error --no-wrap --title="$TITLE" --text="$(zt "$1")" 2>/dev/null; else printf '❌ %s\n' "$1"; fi; }

BIN=""
need_bin() {
  local c
  for c in "${PROTON_BIN:-}" "$(command -v proton-drive 2>/dev/null)" \
           "$BIN_DIR/proton-drive" "$HOME/Downloads/proton-drive" "$HOME/proton-drive"; do
    if [[ -n "$c" && -x "$c" ]]; then BIN="$c"; return 0; fi
  done
  err "$(t no_bin)"; exit 1
}

ask_text() {   # $1 prompt  $2 default
  if (( HAS_GUI )); then
    zenity --entry --title="$TITLE" --text="$(zt "$1")" --entry-text="$2" 2>/dev/null
  else
    local r; read -e -r -i "$2" -p "$1: " r; printf '%s' "$r"
  fi
}

pick() {       # $1 text, then options... ; prints the chosen option
  local text="$1"; shift
  if (( HAS_GUI )); then
    zenity --list --title="$TITLE" --text="$(zt "$text")" --column="$(t col_choose)" \
           --width=540 --height=460 "$@" 2>/dev/null
  else
    printf '%s\n' "$text" >&2
    local o; PS3="$(t opt_prompt)"
    select o in "$@"; do
      if [[ -n "$o" ]]; then printf '%s' "$o"; return 0; fi
    done
    return 1
  fi
}

confirm() {    # $1 title  $2 summary
  if (( HAS_GUI )); then
    zenity --question --title="$1" --no-wrap --text="$(zt "$2")"$'\n\n'"$(t proceed)" 2>/dev/null
  else
    printf '%s\n' "$2"; local ok; read -r -p "$(t yn_prompt)" ok
    [[ "$ok" =~ ^[yYoOsSjJنن]$ ]]
  fi
}

# run_job "progress text" cmd args...   ->  JOB_RC, JOB_OUT   (130 = cancelled)
JOB_RC=0; JOB_OUT=""
run_job() {
  local text="$1"; shift
  JOB_RC=0; JOB_OUT=""
  if (( HAS_GUI )); then
    local tmp pid; tmp=$(mktemp)
    "$@" >"$tmp" 2>&1 </dev/null &
    pid=$!
    ( while kill -0 "$pid" 2>/dev/null; do echo; sleep 0.5; done; echo 100 ) | \
      zenity --progress --pulsate --auto-close --width=420 --title="$TITLE" --text="$(zt "$text")" 2>/dev/null
    if kill -0 "$pid" 2>/dev/null; then kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; JOB_RC=130
    else wait "$pid"; JOB_RC=$?; fi
    JOB_OUT=$(<"$tmp"); rm -f "$tmp"
  else
    "$@"; JOB_RC=$?
  fi
}

# =====================================================================
#  Reading Drive listings (JSON schema is unofficial and may change).
#  Prints  d<TAB>name  or  f<TAB>name  per item.
# =====================================================================
PY=$(cat <<'EOF'
import sys, json
t = sys.stdin.read()
i = min([p for p in (t.find('['), t.find('{')) if p >= 0] or [-1])
if i < 0: sys.exit(1)
o, _ = json.JSONDecoder().raw_decode(t[i:])
def items(o):
    if isinstance(o, list): return o
    if isinstance(o, dict):
        for v in o.values():
            if isinstance(v, list) and v and all(isinstance(x, dict) for x in v): return v
    return []
for it in items(o):
    if not isinstance(it, dict): continue
    name = it.get("name") or it.get("Name")
    if isinstance(name, dict):
        name = name.get("value") if name.get("ok", True) else None
    t_ = str(it.get("type") or it.get("nodeType") or it.get("kind") or "").lower()
    isdir = bool(it.get("isFolder") or it.get("isDirectory")) or "folder" in t_ or t_ in ("dir", "directory")
    if name and "\n" not in name and "\t" not in name:
        print(("d" if isdir else "f") + "\t" + name)
EOF
)

ITEMS=()
list_items() {
  command -v python3 >/dev/null 2>&1 || return 1
  local out
  out=$("$BIN" filesystem list "$1" --json 2>/dev/null) || return 1
  mapfile -t ITEMS < <(printf '%s' "$out" | python3 -c "$PY" 2>/dev/null)
  return 0
}

trim() { sed 's/^[[:space:]]*//;s/[[:space:]]*$//' <<<"$1"; }

# =====================================================================
#  Upload
# =====================================================================
DEST=""; LAST_DEST="/my-files"; UP_FILES=()

manual_dest() {
  local base="$1" x
  x=$(ask_text "$(t manual_prompt "$base")" "") || exit 0
  x="$(trim "$x")"; x="${x%/}"
  if   [[ -z "$x" ]];            then DEST="$base"
  elif [[ "$x" == /my-files* ]]; then DEST="$x"
  else                                DEST="$base/${x#/}"
  fi
}

choose_dest() {
  local cur="/my-files" opts choice line k n newname
  while true; do
    if list_items "$cur"; then
      opts=("✅ $(t here "$cur")")
      if [[ "$cur" == "/my-files" && "$LAST_DEST" != "/my-files" ]]; then opts+=("⭐ $(t last "$LAST_DEST")"); fi
      [[ "$cur" != "/my-files" ]] && opts+=("⬆ $(t back)")
      for line in "${ITEMS[@]}"; do
        k="${line%%$'\t'*}"; n="${line#*$'\t'}"
        [[ "$k" == d && -n "$n" && "$n" != */* ]] && opts+=("📁 $n")
      done
      opts+=("➕ $(t newf)" "✏ $(t manual)")
      choice=$(pick "$(t loc "$cur")" "${opts[@]}") || exit 0
      case "$choice" in
        "✅ "*) DEST="$cur"; return ;;
        "⭐ "*) DEST="$LAST_DEST"; return ;;
        "⬆ "*)  cur="${cur%/*}" ;;
        "📁 "*) cur="$cur/${choice#📁 }" ;;
        "➕ "*)
          newname=$(ask_text "$(t new_name "$cur")" "") || exit 0
          newname="$(trim "${newname//\//}")"
          if [[ -n "$newname" ]]; then
            if "$BIN" filesystem create-folder "$cur" "$newname" >/dev/null 2>&1; then
              cur="$cur/$newname"
            else
              err "$(t mk_fail "$newname")"
            fi
          fi ;;
        "✏ "*)  manual_dest "$cur"; return ;;
      esac
    else
      say "$(t list_fail_up)"
      manual_dest "$cur"; return
    fi
  done
}

read_paths() {
  printf '%s\n' "$(t t_path_help)"
  local p
  while true; do
    read -e -r -p "$(t t_path_prompt)" p
    [[ -z "$p" ]] && break
    p="${p#\'}"; p="${p%\'}"; p="${p/#\~/$HOME}"
    UP_FILES+=("$p")
  done
}

cmd_upload() {
  need_bin
  local mode d out f c names n summary fstrat flabel
  [[ -f "$CONF_DIR/last_dest" ]] && LAST_DEST=$(<"$CONF_DIR/last_dest")
  UP_FILES=()

  if (( $# > 0 )); then
    UP_FILES=("$@")
  else
    mode=$(pick "$(t up_what)" "📄 $(t w_files)" "📁 $(t w_folder)") || exit 0
    if [[ "$mode" == "📁 "* ]]; then
      if (( HAS_GUI )); then
        d=$(zenity --file-selection --directory --title="$(t pick_folder)" 2>/dev/null) || exit 0
      else
        read -e -r -p "$(t t_dir_prompt)" d; d="${d#\'}"; d="${d%\'}"; d="${d/#\~/$HOME}"
      fi
      UP_FILES=("$d")
    elif (( HAS_GUI )); then
      out=$(zenity --file-selection --multiple --separator=$'\n' --title="$(t pick_files)" 2>/dev/null) || exit 0
      mapfile -t UP_FILES <<<"$out"
    else
      read_paths
    fi
  fi

  (( ${#UP_FILES[@]} > 0 )) && [[ -n "${UP_FILES[0]}" ]] || { err "$(t nothing)"; exit 1; }
  for f in "${UP_FILES[@]}"; do [[ -e "$f" ]] || { err "$(t not_found "$f")"; exit 1; }; done

  choose_dest

  c=$(pick "$(t cq_up)" "📎 $(t c_keep)" "🔁 $(t c_rev)" "♻ $(t c_replace)" "⏭ $(t c_skip)") || exit 0
  fstrat="rename"; flabel="$(t l_keep)"
  case "$c" in
    "📎 "*) fstrat="rename";              flabel="$(t l_keep)" ;;
    "🔁 "*) fstrat="create-new-revision"; flabel="$(t l_rev)" ;;
    "♻ "*)  fstrat="replace";             flabel="$(t l_replace)" ;;
    "⏭ "*)  fstrat="skip";                flabel="$(t l_skip)" ;;
  esac

  names=""; n=0
  for f in "${UP_FILES[@]}"; do
    (( n < 5 )) && names+="• $(basename "$f")"$'\n'
    n=$((n+1))
  done
  (( n > 5 )) && names+="$(t and_more $((n-5)))"$'\n'
  summary="$(t sum_up "$names" "$DEST" "$flabel")"
  confirm "$(t confirm_up)" "$summary" || { (( HAS_GUI )) || t aborted; exit 0; }

  command -v notify-send >/dev/null 2>&1 && notify-send "$TITLE" "…" 2>/dev/null
  run_job "$(t uploading "$DEST")" "$BIN" filesystem upload -f "$fstrat" -d merge "${UP_FILES[@]}" "$DEST"

  if   (( JOB_RC == 0 ));   then echo "$DEST" > "$CONF_DIR/last_dest"; say "✅ $(t up_ok "$DEST")"
  elif (( JOB_RC == 130 )); then say "⚠ $(t cancelled)"; exit 1
  else err "$(t up_fail "${JOB_OUT: -400}")"; exit 1
  fi
}

# =====================================================================
#  Download
# =====================================================================
SEL=()

select_here() {
  local cur="$1" line k n sel s icon
  SEL=()
  if (( HAS_GUI )); then
    local args=()
    for line in "${ITEMS[@]}"; do
      k="${line%%$'\t'*}"; n="${line#*$'\t'}"
      [[ -n "$n" ]] || continue
      [[ "$k" == d ]] && icon="📁" || icon="📄"
      args+=(FALSE "$icon" "$n")
    done
    (( ${#args[@]} )) || { say "$(t empty)"; return; }
    sel=$(zenity --list --checklist --title="$TITLE" --text="$(zt "$(t dl_check "$cur")")" \
          --column="$(t col_choose)" --column="$(t col_type)" --column="$(t col_name)" \
          --print-column=3 --separator=$'\n' --width=600 --height=500 "${args[@]}" 2>/dev/null) || return
    mapfile -t sel <<<"$sel"
    for s in "${sel[@]}"; do [[ -n "$s" ]] && SEL+=("$cur/${s//\//\\/}"); done   # remote paths escape "/" in names
  else
    local labels=() choice
    for line in "${ITEMS[@]}"; do
      k="${line%%$'\t'*}"; n="${line#*$'\t'}"
      [[ -n "$n" ]] || continue
      [[ "$k" == d ]] && icon="📁" || icon="📄"
      labels+=("$icon $n")
    done
    (( ${#labels[@]} )) || { say "$(t empty)"; return; }
    choice=$(pick "$(t dl_one)" "${labels[@]}") || return
    s="${choice#* }"; SEL=("$cur/${s//\//\\/}")
  fi
}

browse_remote() {
  local cur="/my-files" opts choice line k n x
  while true; do
    if list_items "$cur"; then
      opts=()
      [[ "$cur" != "/my-files" ]] && opts+=("⬇ $(t dl_all "$cur")")
      opts+=("☑ $(t dl_select)")
      [[ "$cur" != "/my-files" ]] && opts+=("⬆ $(t back)")
      for line in "${ITEMS[@]}"; do
        k="${line%%$'\t'*}"; n="${line#*$'\t'}"
        [[ "$k" == d && -n "$n" && "$n" != */* ]] && opts+=("📁 $n")
      done
      choice=$(pick "$(t loc "$cur")" "${opts[@]}") || exit 0
      case "$choice" in
        "⬇ "*) SEL=("$cur"); return ;;
        "☑ "*) select_here "$cur"; (( ${#SEL[@]} )) && return ;;
        "⬆ "*) cur="${cur%/*}" ;;
        "📁 "*) cur="$cur/${choice#📁 }" ;;
      esac
    else
      say "$(t dl_list_fail)"
      x=$(ask_text "$(t dl_manual)" "$cur") || exit 0
      x="$(trim "$x")"; [[ -n "$x" ]] || exit 0
      SEL=("$x"); return
    fi
  done
}

cmd_download() {
  need_bin
  local lastdl="$HOME/Downloads" dir help copts c fargs=() flabel f names n summary
  [[ -f "$CONF_DIR/last_download_dir" ]] && lastdl=$(<"$CONF_DIR/last_download_dir")

  SEL=()
  if (( $# > 0 )); then SEL=("$@"); else browse_remote; fi
  (( ${#SEL[@]} > 0 )) || { err "$(t nothing)"; exit 1; }

  if (( HAS_GUI )); then
    dir=$(zenity --file-selection --directory --filename="$lastdl/" --title="$(t dl_where)" 2>/dev/null) || exit 0
  else
    dir=$(ask_text "$(t t_save_prompt)" "$lastdl"); dir="${dir/#\~/$HOME}"
  fi
  [[ -n "$dir" ]] || exit 0
  mkdir -p "$dir" || { err "$(t not_found "$dir")"; exit 1; }

  # Offer only the conflict strategies this CLI version actually supports.
  help=$("$BIN" filesystem download --help 2>&1)
  has() { grep -qiE "(^|[^a-z-])$1([^a-z-]|$)" <<<"$help"; }
  copts=()
  has rename && copts+=("📎 $(t d_keep)")
  has remove && copts+=("♻ $(t d_remove)")
  has skip   && copts+=("⏭ $(t d_skip)")
  flabel="$(t l_none)"
  if (( ${#copts[@]} )); then
    c=$(pick "$(t cq_dl)" "${copts[@]}") || exit 0
    case "$c" in
      "📎 "*) fargs=(-f rename); flabel="$(t l_keep)" ;;
      "♻ "*)  fargs=(-f remove); flabel="⚠ $(t l_remove)" ;;
      "⏭ "*)  fargs=(-f skip);   flabel="$(t l_skip)" ;;
    esac
  fi
  has merge && fargs+=(-d merge)

  names=""; n=0
  for f in "${SEL[@]}"; do
    (( n < 5 )) && names+="• ${f##*/}"$'\n'
    n=$((n+1))
  done
  (( n > 5 )) && names+="$(t and_more $((n-5)))"$'\n'
  summary="$(t sum_dl "$names" "$dir" "$flabel")"
  confirm "$(t confirm_dl)" "$summary" || { (( HAS_GUI )) || t aborted; exit 0; }

  run_job "$(t downloading "$dir")" "$BIN" filesystem download "${fargs[@]}" "${SEL[@]}" "$dir"

  if (( JOB_RC == 0 )); then
    echo "$dir" > "$CONF_DIR/last_download_dir"
    if (( HAS_GUI )); then
      zenity --question --no-wrap --title="$TITLE" \
        --text="$(zt "✅ $(t dl_ok "$dir")")"$'\n\n'"$(t open_q)" 2>/dev/null && xdg-open "$dir" >/dev/null 2>&1
    else
      printf '✅ %s\n' "$(t dl_ok "$dir")"
    fi
  elif (( JOB_RC == 130 )); then say "⚠ $(t cancelled)"; exit 1
  else err "$(t dl_fail "${JOB_OUT: -400}")"; exit 1
  fi
}

# =====================================================================
#  Language, menu, install
# =====================================================================
cmd_lang() {
  local code="${1:-}" c
  if [[ -z "$code" ]]; then
    c=$(pick "$(t lang_q)" "English" "العربية" "Français" "Español" "Deutsch") || return 0
    case "$c" in
      English) code=en ;; العربية) code=ar ;; Français) code=fr ;; Español) code=es ;; Deutsch) code=de ;;
    esac
  fi
  case "$code" in
    en|ar|fr|es|de) echo "$code" > "$CONF_DIR/lang"; LANG_CODE="$code"; load_lang ;;
    *) echo "Supported: en ar fr es de" >&2; return 1 ;;
  esac
}

cmd_menu() {
  need_bin
  local c
  c=$(pick "$(t menu_q)" "⬆ $(t m_upload)" "⬇ $(t m_download)" "🌐 $(t m_lang)") || exit 0
  case "$c" in
    "⬆ "*) cmd_upload ;;
    "⬇ "*) cmd_download ;;
    "🌐 "*) cmd_lang; cmd_menu ;;
  esac
}

cmd_install() {
  local desktop=0 icon_src="" d
  while (( $# )); do
    case "$1" in
      --desktop) desktop=1; shift ;;
      --icon)    icon_src="${2:-}"; shift 2 ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done
  mkdir -p "$BIN_DIR" "$APP_DIR" "$ICON_BASE/scalable/apps" "$ICON_BASE/256x256/apps"
  [[ "$SELF" == "$BIN_DIR/$APP_ID" ]] || install -m 755 "$SELF" "$BIN_DIR/$APP_ID"

  if [[ -n "$icon_src" ]]; then
    [[ -f "$icon_src" ]] || { echo "Icon not found: $icon_src" >&2; exit 1; }
    case "$icon_src" in
      *.svg) cp "$icon_src" "$ICON_BASE/scalable/apps/$APP_ID.svg"; rm -f "$ICON_BASE/256x256/apps/$APP_ID.png" ;;
      *)     cp "$icon_src" "$ICON_BASE/256x256/apps/$APP_ID.png"; rm -f "$ICON_BASE/scalable/apps/$APP_ID.svg" ;;
    esac
  elif [[ ! -f "$ICON_BASE/scalable/apps/$APP_ID.svg" && ! -f "$ICON_BASE/256x256/apps/$APP_ID.png" ]]; then
    cat > "$ICON_BASE/scalable/apps/$APP_ID.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
<!-- generic icon, NOT the Proton logo -->
<rect width="256" height="256" rx="56" fill="#6d4aff"/>
<path d="M82 178a38 38 0 0 1 2-76 54 54 0 0 1 100 16 31 31 0 0 1-2 60z" fill="#fff"/>
<path d="M128 168v-52m0 0-22 22m22-22 22 22" stroke="#6d4aff" stroke-width="13" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
SVG
  fi

  cat > "$APP_DIR/$APP_ID.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Proton Drive GUI (unofficial)
Name[ar]=واجهة Proton Drive (غير رسمية)
Name[fr]=Proton Drive GUI (non officiel)
Name[es]=Proton Drive GUI (no oficial)
Name[de]=Proton Drive GUI (inoffiziell)
Comment=Upload and download files with Proton Drive
Exec=$BIN_DIR/$APP_ID
Icon=$APP_ID
Terminal=false
Categories=Network;FileTransfer;
Keywords=proton;drive;upload;download;cloud;
Actions=Upload;Download;

[Desktop Action Upload]
Name=Upload
Name[ar]=رفع
Name[fr]=Envoyer
Name[es]=Subir
Name[de]=Hochladen
Exec=$BIN_DIR/$APP_ID upload %F

[Desktop Action Download]
Name=Download
Name[ar]=تنزيل
Name[fr]=Télécharger
Name[es]=Descargar
Name[de]=Herunterladen
Exec=$BIN_DIR/$APP_ID download
EOF
  chmod +x "$APP_DIR/$APP_ID.desktop"

  if (( desktop )); then
    d="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
    if [[ -d "$d" ]]; then
      cp "$APP_DIR/$APP_ID.desktop" "$d/$APP_ID.desktop"; chmod +x "$d/$APP_ID.desktop"
      gio set "$d/$APP_ID.desktop" metadata::trusted true 2>/dev/null || true
    fi
  fi
  update-desktop-database "$APP_DIR" 2>/dev/null || true
  gtk-update-icon-cache -f -t "$ICON_BASE" 2>/dev/null || true
  printf '✓ %s\n' "$(t inst_ok "$(t app_name)")"
}

cmd_uninstall() {
  local d
  d="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
  rm -f "$BIN_DIR/$APP_ID" "$APP_DIR/$APP_ID.desktop" "$d/$APP_ID.desktop" \
        "$ICON_BASE/scalable/apps/$APP_ID.svg" "$ICON_BASE/256x256/apps/$APP_ID.png"
  update-desktop-database "$APP_DIR" 2>/dev/null || true
  printf '✓ %s\n' "$(t uninst_ok)"
}

usage() {
  sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//'
}

main() {
  case "${1:-menu}" in
    menu)            cmd_menu ;;
    upload|up)       shift; cmd_upload "$@" ;;
    download|down|dl) shift; cmd_download "$@" ;;
    install)         shift; cmd_install "$@" ;;
    uninstall)       cmd_uninstall ;;
    lang)            shift; cmd_lang "$@" ;;
    -v|--version)    echo "$APP_ID $VERSION" ;;
    -h|--help|help)  usage ;;
    *) if [[ -e "$1" ]]; then cmd_upload "$@"; else usage; exit 1; fi ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
