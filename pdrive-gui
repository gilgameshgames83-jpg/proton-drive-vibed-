#!/usr/bin/env bash
# pdrive-gui - unofficial GUI for the official Proton Drive CLI (upload / download).
# NOT affiliated with, endorsed by, or sponsored by Proton AG.
# "Proton" and "Proton Drive" are trademarks of Proton AG.
# License: MIT (see LICENSE)
#
# Usage:
#   pdrive-gui                      main menu
#   pdrive-gui upload [FILE...]     upload files/folders
#   pdrive-gui download [PATH...]   download from Drive (PATH like /my-files/x.pdf)
#   pdrive-gui install [--desktop] [--icon FILE]   add to applications menu
#   pdrive-gui uninstall
#   pdrive-gui lang [en|ar|fr|es|de]

VERSION="1.0.0"
APP_ID="pdrive-gui"

if (( BASH_VERSINFO[0] < 4 )); then echo "bash 4+ is required" >&2; exit 1; fi

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_ID"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
BIN_DIR="$HOME/.local/bin"
APP_DIR="$DATA_DIR/applications"
ICON_BASE="$DATA_DIR/icons/hicolor"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
TITLE="Proton Drive"
mkdir -p "$CONF_DIR"

